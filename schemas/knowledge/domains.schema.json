{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "domains"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "domains": {
      "type": "array",
      "minItems": 7,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "knowledge_path",
          "status",
          "production_stage"
        ],
        "properties": {
          "id": {
            "enum": [
              "yijing",
              "liuyao",
              "qimen",
              "ziwei",
              "fengshui",
              "liuren",
              "bazi",
              "dream"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_path": {
            "type": "string",
            "pattern": "^data/canonical/[a-z]+/phase1_knowledge\\.json$"
          },
          "status": {
            "enum": [
              "in_progress",
              "phase1_complete"
            ]
          },
          "production_stage": {
            "const": "canonical"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "yijing"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "liuyao"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "qimen"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "ziwei"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "fengshui"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "liuren"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "bazi"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1
        }
      ]
    }
  }
}

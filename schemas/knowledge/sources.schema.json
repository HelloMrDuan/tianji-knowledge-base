{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "url",
          "repository",
          "commit",
          "path",
          "license",
          "retrieved_at",
          "content_path",
          "sha256",
          "rights_basis",
          "review_scope",
          "author",
          "era",
          "public_domain",
          "evidence_level",
          "kind",
          "content_format",
          "blob_sha"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1
          },
          "content_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rights_basis": {
            "type": "string",
            "minLength": 1
          },
          "review_scope": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "era": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_domain": {
            "type": "boolean"
          },
          "evidence_level": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "kind": {
            "enum": [
              "classical",
              "implementation"
            ]
          },
          "content_format": {
            "enum": [
              "text",
              "json"
            ]
          },
          "blob_sha": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "domain",
    "provider",
    "review_basis",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "domain": {
      "enum": [
        "liuyao",
        "qimen",
        "liuren",
        "ziwei",
        "fengshui",
        "yijing"
      ]
    },
    "model": {
      "const": "phase2-golden"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "review_basis": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "variant",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object"
          },
          "expected": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  }
}

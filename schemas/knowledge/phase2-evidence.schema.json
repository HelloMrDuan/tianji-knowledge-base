{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "domain",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "domain": {
      "enum": [
        "liuyao",
        "qimen",
        "liuren",
        "ziwei",
        "fengshui",
        "yijing",
        "bazi"
      ]
    },
    "model": {
      "const": "phase2-evidence"
    },
    "classics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "domain",
          "source_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "liuyao",
              "qimen",
              "liuren",
              "ziwei",
              "fengshui",
              "yijing",
              "bazi"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule_ids",
          "source_id",
          "classic_id",
          "chapter_title",
          "locator",
          "original_text",
          "review_status",
          "independence_status",
          "variants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "classic_id": {
            "type": "string",
            "minLength": 1
          },
          "chapter_title": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "original_text": {
            "type": "string",
            "minLength": 1
          },
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review_status": {
            "const": "approved"
          },
          "independence_status": {
            "enum": [
              "same_edition_as_phase1",
              "different_work_unverified_edition",
              "unverified"
            ]
          }
        }
      }
    }
  }
}

 "evidence": {
  "E01": {
   "classic_title": "渊海子平",
   "original_text": "四柱排定,三才次分,专以日上天元,配合八字支干;有见不见之形,无时不有;神煞相绊,轻重较量。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E02": {
   "classic_title": "渊海子平",
   "original_text": "以甲为例★见甲:为比肩、兄弟。\n 见乙:为劫财、败财,剋父及妻。\n 见丙:为食神、天厨、寿星,为男。\n 见丁:为伤官、退财、耗气,子甥。\n 见戊:为偏财、偏妻、偏妾,剋子。\n 见己:为正财、正妻,剋母,为合神。\n 见庚:为偏官、七杀、官鬼、",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": true
  },
  "E03": {
   "classic_title": "渊海子平",
   "original_text": "以乙为例★见甲:为劫财、逐马,剋妻。\n 见乙:为比肩、兄弟、朋友。\n 见丙:为伤官、小人、盗气,为姪。\n 见丁:为食神、天厨、寿星,子孙。\n 见戊:为正财、正妻,剋母。\n 见己:为偏财、偏妻、偏妾,剋子。\n 见庚:为正官、禄马,剋父母。\n ",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": true
  },
  "E04": {
   "classic_title": "渊海子平",
   "original_text": "又云,伤官者,我生彼之谓也;以阳见阴,阴见阳,亦名盗气。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E05": {
   "classic_title": "渊海子平",
   "original_text": "何谓之正财?犹如正官之意;是阴见阳财,阳见阴财。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E06": {
   "classic_title": "渊海子平",
   "original_text": "夫正官者,甲见辛之类;乃阴见阳为官,阳见阴为鬼,阴阳配合成其道也。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E07": {
   "classic_title": "渊海子平",
   "original_text": "夫印綬者,生我之谓也,亦名生气。以阳见阴,以阴见阳,谓之正印;阳见阳,阴见阴,谓之偏印。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E08": {
   "classic_title": "渊海子平",
   "original_text": "子宫癸水在其中,丑癸辛金己土同;寅宫甲木兼丙戊,卯宫乙木独相逢。辰藏乙戊三分癸,巳中庚金丙戊丛;午宫丁火并己土,未宫乙己丁共宗。申位庚金壬水戊,酉宫辛金独丰隆;戌宫辛金及丁戊,亥藏壬甲是真踪。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E09": {
   "classic_title": "滴天髓阐微",
   "original_text": "月令乃提纲之府,譬之宅也,人元为用事之神,宅之定向也,不可以不卜。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E10": {
   "classic_title": "滴天髓阐微",
   "original_text": "如寅月生人,立春后七日前,皆值戊土用事;八日后十四日前者,丙火用事 ;十五日后,甲木用事。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E11": {
   "classic_title": "滴天髓阐微",
   "original_text": "得时俱为旺论,失令便作衰看,虽是至理,亦死法也。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E12": {
   "classic_title": "渊海子平",
   "original_text": "子宫癸水在其中,丑癸辛金己土同;寅宫甲木兼丙戊,卯宫乙木独相逢。辰藏乙戊三分癸,巳中庚金丙戊丛;午宫丁火并己土,未宫乙己丁共宗。申位庚金壬水戊,酉宫辛金独丰隆;戌宫辛金及丁戊,亥藏壬甲是真踪。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E13": {
   "classic_title": "滴天髓阐微",
   "original_text": "天干得一比肩,不如地支得一余气墓库。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E14": {
   "classic_title": "滴天髓阐微",
   "original_text": "余气者,如丙丁逢未,甲乙逢辰,庚辛逢戌,壬癸逢丑之类是也,得二比肩,不如支中得一长生禄旺,如甲乙逢亥寅卯之类是也。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E15": {
   "classic_title": "滴天髓阐微",
   "original_text": "得时俱为旺论,失令便作衰看,虽是至理,亦死法也。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E16": {
   "classic_title": "渊海子平",
   "original_text": "子宫癸水在其中,丑癸辛金己土同;寅宫甲木兼丙戊,卯宫乙木独相逢。辰藏乙戊三分癸,巳中庚金丙戊丛;午宫丁火并己土,未宫乙己丁共宗。申位庚金壬水戊,酉宫辛金独丰隆;戌宫辛金及丁戊,亥藏壬甲是真踪。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },
  "E17": {
   "classic_title": "滴天髓阐微",
   "original_text": "故知地支人元必得天干引助,天干为用,必要地支司令。",
   "evidence_level": "C",
   "classic_title_excerpt": false,
   "original_text_excerpt": false
  },

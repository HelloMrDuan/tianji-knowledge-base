# Copy values into process/cloud environment; never commit a real API key.
# This file is a reference only; the API does not automatically load .env files.
# Local Qiniu calibration: python scripts/calibrate_qiniu.py --evaluate
# It sets https://api.qnaigc.com/v1 in its child environment and prompts for a key.
TIANJI_AI_PROVIDER=disabled
# json-http: full explanation endpoint; openai-compatible: API base or /chat/completions endpoint.
TIANJI_AI_BASE_URL=https://api.qnaigc.com/v1
TIANJI_AI_MODEL=
TIANJI_AI_API_KEY=
TIANJI_AI_TIMEOUT_SECONDS=20
# Optional comma-separated frontend origins. Empty keeps same-origin access.
TIANJI_CORS_ORIGINS=

# Prompt v1 is retained for internal baseline comparison; production explains with v2.
TIANJI_EXPLANATION_PROMPT_VERSION=explanation-prompt-v2
TIANJI_AI_MAX_OUTPUT_TOKENS=4096

# Tianji public WEB image — public-repo-only replica of the private repo's
# deploy/Dockerfile.public-web (which cannot be used from the public repo
# because it lives in HelloMrDuan/tianji-private-knowledge).
# Commit this file at the PUBLIC repo root as ./public-Dockerfile.web.
# Build context MUST be the pure frontend directory web/visual-prototype
# (the deploy pipeline guarantees this), containing no private material.
#
# Steps mirrored from the private Dockerfile (per the deployment spec):
#   node:24-alpine runs `npm ci && npm run build`, then dist/ is copied
#   into the unprivileged nginx image at /usr/share/nginx/html, EXPOSE 8080.
#
# The one piece that cannot be copied is the private deploy/nginx.conf.
# Its behaviour, as documented in the deployment spec, is reproduced by
# the embedded config below:
#   - static site from /usr/share/nginx/html (SPA fallback to index.html)
#   - /api/  proxied to the sealed API service http://tianji-api:8000
#   - = /health proxied to the API /health
#   - hard 404 for /api/v1/admin, /data/, /build/, /config/, /schemas/,
#     /.git, /.env (blocked even though dist/ never contains them,
#     because the SPA fallback would otherwise answer 200)
# In production the private repo's own Dockerfile.public-web + nginx.conf
# remain authoritative; this file exists so public branch pushes can
# publish a faithful preview image without touching the private repo.

# ---------- build stage ----------
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./
RUN npm run build

# ---------- runtime stage ----------
# NOTE: if Docker Hub rate-limits this pull (HTTP 429, already observed
# on the InstaBox host), the official mirror
# ghcr.io/nginx/nginx-unprivileged:stable-alpine is the same image.
FROM nginxinc/nginx-unprivileged:stable-alpine
COPY --from=build /app/dist /usr/share/nginx/html

# nginx server config (BuildKit heredoc; no file in the build context).
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Health is answered by the sealed API, as in the private stack.
    location = /health {
        proxy_pass http://tianji-api:8000/health;
        proxy_set_header Host \$host;
        access_log off;
    }

    # Admin surface is never public (private nginx returns 404).
    location /api/v1/admin {
        return 404;
    }

    # Public API: deterministic public execute / scenarios / capabilities.
    location /api/ {
        proxy_pass http://tianji-api:8000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    # Private or build material must never be served statically.
    location /data/    { return 404; }
    location /build/   { return 404; }
    location /config/  { return 404; }
    location /schemas/ { return 404; }
    location /.git     { return 404; }
    location /.env     { return 404; }

    # Static frontend with SPA fallback.
    location / {
        try_files \$uri \$uri/ /index.html;
    }
}
EOF

EXPOSE 8080
